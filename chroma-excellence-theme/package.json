{
  "name": "chroma-excellence-theme",
  "version": "2.0.0",
  "description": "Chroma Early Learning Academy v2 theme with Prismpath™ curriculum and redesigned homepage/page templates",
  "private": true,
  "scripts": {
    "dev:css": "postcss assets/css/input.css -o assets/css/main.css --watch",
    "build:vendor": "node scripts/build-vendor-assets.js",
    "build:css": "node scripts/build-css.js",
    "build:rev": "node scripts/rev-theme-assets.js",
    "dev": "npm run dev:css",
    "build": "npm run build:vendor && npm run build:css && npm run build:rev"
  },
  "keywords": [
    "wordpress",
    "theme",
    "tailwind",
    "childcare",
    "education"
  ],
  "author": "Chroma Development Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "@axe-core/cli": "^4.11.0",
    "autoprefixer": "^10.4.16",
    "chrome-launcher": "^1.2.1",
    "cssnano": "^6.0.1",
    "eslint": "^9.39.2",
    "lighthouse": "^13.0.1",
    "leaflet": "1.9.4",
    "postcss": "^8.4.32",
    "postcss-cli": "^11.0.0",
    "purgecss": "^7.0.2",
    "tailwindcss": "^3.4.0",
    "terser": "^5.44.1"
  }
}
