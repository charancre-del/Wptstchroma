{
    "name": "chroma-school-dashboard",
    "version": "1.0.0",
    "description": "Build pipeline for Director Portal and TV Display",
    "private": true,
    "scripts": {
        "build:js": "esbuild --bundle ./assets/src/portal.jsx --minify --sourcemap --outfile=assets/dist/portal.js --define:process.env.NODE_ENV=\\\"production\\\" --external:react --external:react-dom",
        "build:css": "tailwindcss -i assets/src/portal.css -o assets/dist/portal.css --minify",
        "build": "npm run build:js && npm run build:css",
        "watch": "npm run build:js -- --watch & npm run build:css -- --watch"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.24",
        "esbuild": "^0.28.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^3.4.19"
    }
}
