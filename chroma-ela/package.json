{
  "name": "chroma-ela-theme",
  "version": "1.0.0",
  "description": "Custom WordPress theme for Chroma Early Learning Academy",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:css": "tailwindcss -i ./resources/css/app.css -o ./dist/app.css --watch",
    "dev:js": "esbuild ./resources/js/app.js --bundle --outfile=./dist/app.js --watch",
    "build": "npm-run-all build:*",
    "build:css": "tailwindcss -i ./resources/css/app.css -o ./dist/app.css --minify",
    "build:js": "esbuild ./resources/js/app.js --bundle --minify --outfile=./dist/app.js"
  },
  "keywords": [
    "wordpress",
    "theme",
    "tailwind",
    "education",
    "childcare"
  ],
  "author": "Chroma Development Team",
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "^0.19.0",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {}
}
