#
# Legacy sitemap URL hard redirects
# Ensures stale physical files (e.g., sitemap_index.xml) cannot bypass WP sitemap providers.
#
<IfModule mod_rewrite.c>
RewriteEngine On

# Core WP sitemap pretty URLs -> query vars (works even when DB rewrite rules are stale)
RewriteRule ^wp-sitemap\.xml$ /index.php?sitemap=index [L,QSA]
RewriteRule ^wp-sitemap\.xsl$ /index.php?sitemap-stylesheet=sitemap [L,QSA]
RewriteRule ^wp-sitemap-index\.xsl$ /index.php?sitemap-stylesheet=index [L,QSA]
RewriteRule ^wp-sitemap-([a-z]+)-([a-z0-9_-]+)-([0-9]+)\.xml$ /index.php?sitemap=$1&sitemap-subtype=$2&paged=$3 [L,QSA,NC]
RewriteRule ^wp-sitemap-([a-z]+)-([0-9]+)\.xml$ /index.php?sitemap=$1&paged=$2 [L,QSA,NC]

RewriteRule ^sitemap_index\.xml$ /wp-sitemap.xml [R=301,L]
RewriteRule ^sitemap\.xml$ /wp-sitemap.xml [R=301,L]
RewriteRule ^sitemap-spanish\.xml$ /wp-sitemap-spanish-1.xml [R=301,L]
RewriteRule ^sitemap-combos\.xml$ /wp-sitemap-combos-1.xml [R=301,L]
RewriteRule ^sitemap-combos-es\.xml$ /wp-sitemap-comboses-1.xml [R=301,L]
RewriteRule ^sitemap-near-me\.xml$ /wp-sitemap-nearme-1.xml [R=301,L]
RewriteRule ^sitemap-near-me-es\.xml$ /wp-sitemap-nearmees-1.xml [R=301,L]
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /

# Force Non-WWW (chromaela.com)
# Force Non-WWW
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Force Trailing Slash (prevent duplicate URLs in sitemap)
# Skip if it's an actual file or already has trailing slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteCond %{REQUEST_URI} !\.(xml|json|txt|html|php|css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|pdf)$
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L]

RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Font Caching
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>
