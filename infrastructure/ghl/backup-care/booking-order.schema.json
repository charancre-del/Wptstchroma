{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chromaela.com/schemas/backup-care-booking-order-v1.json",
  "title": "Chroma Backup Care Booking Order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "client_request_id",
    "campus_id",
    "parent",
    "children",
    "attendance",
    "policy_acceptance"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "client_request_id": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "description": "An opaque idempotency key generated once per cart."
    },
    "campus_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_name", "last_name", "email", "mobile_phone"],
      "properties": {
        "first_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "last_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "mobile_phone": { "type": "string", "minLength": 7, "maxLength": 32 }
      }
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_child_id",
          "first_name",
          "last_name",
          "date_of_birth",
          "age_group",
          "enrollment_record_id",
          "enrollment_record_complete"
        ],
        "properties": {
          "client_child_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "first_name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "last_name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "date_of_birth": { "type": "string", "format": "date" },
          "age_group": {
            "enum": ["infant", "toddler", "preschool", "school"]
          },
          "enrollment_record_id": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "Opaque GHL Backup Care Child Custom Object record ID."
          },
          "enrollment_record_complete": { "const": true }
        }
      }
    },
    "attendance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 310,
      "description": "Explicit child/date pairs; each item is one billable unit.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["client_child_id", "care_date"],
        "properties": {
          "client_child_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "care_date": { "type": "string", "format": "date" },
          "planned_dropoff_local": {
            "type": "string",
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      }
    },
    "policy_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup_care_terms",
        "full_payment",
        "refund_and_reschedule_deadline",
        "no_discretionary_exceptions",
        "privacy_and_communications"
      ],
      "properties": {
        "backup_care_terms": { "const": true },
        "full_payment": { "const": true },
        "refund_and_reschedule_deadline": { "const": true },
        "no_discretionary_exceptions": { "const": true },
        "privacy_and_communications": { "const": true }
      }
    }
  }
}
